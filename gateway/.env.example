# Gateway mode: "consentchain" (on-chain ABAC)
MODE=consentchain

# JSON-RPC endpoint (local Hardhat node)
RPC_URL=http://127.0.0.1:8545

# Gateway wallet private key (Hardhat account #0)
GATEWAY_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed contract addresses (fill after deploy)
SUBJECT_REGISTRY_ADDRESS=
DATA_REGISTRY_ADDRESS=
CONSENT_MANAGER_ADDRESS=
AUDIT_LOG_ADDRESS=

# Capability token TTL in seconds
CAPABILITY_TTL_SECONDS=300

# Server ports
GATEWAY_PORT=4000
